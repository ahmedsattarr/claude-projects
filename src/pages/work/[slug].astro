---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Static paths — we use client-side fetch for content
export async function getStaticPaths() {
  return [];
}

const { slug } = Astro.params;
---
<BaseLayout title="Project — Ahmed Sattar">
  <!-- Loading state -->
  <div id="project-loading" class="container-site section-y">
    <div style="max-width:800px;margin:0 auto;">
      <div class="skeleton" style="height:40px;width:40%;margin-bottom:16px;"></div>
      <div class="skeleton" style="height:24px;width:70%;margin-bottom:40px;"></div>
      <div class="skeleton" style="aspect-ratio:16/9;margin-bottom:40px;"></div>
      <div class="skeleton" style="height:16px;width:100%;margin-bottom:8px;"></div>
      <div class="skeleton" style="height:16px;width:90%;margin-bottom:8px;"></div>
      <div class="skeleton" style="height:16px;width:75%;"></div>
    </div>
  </div>

  <!-- Project content -->
  <div id="project-content" style="display:none;">
    <!-- Hero -->
    <div id="project-hero" style="background:var(--surface);padding:80px 0 0;">
      <div class="container-site" style="max-width:900px;">
        <div style="margin-bottom:16px;" id="project-breadcrumb">
          <a href="/work" style="font-size:0.875rem;color:var(--muted);text-decoration:none;">&larr; Work</a>
        </div>
        <div id="project-badges" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;"></div>
        <h1 class="text-display" id="project-title" style="margin-bottom:16px;"></h1>
        <p id="project-short-desc" style="font-size:1.125rem;color:var(--muted);max-width:640px;line-height:1.7;margin-bottom:32px;"></p>

        <!-- Meta row -->
        <div id="project-meta" style="display:flex;flex-wrap:wrap;gap:32px;padding:24px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin-bottom:0;"></div>
      </div>
    </div>

    <!-- Cover image -->
    <div id="project-cover-wrap" style="background:var(--surface);padding:40px 0;">
      <div class="container-site" style="max-width:900px;">
        <!-- PLACEHOLDER: replaced by actual cover -->
        <img id="project-cover" src="" alt="" loading="eager" width="900" height="506"
          style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:var(--radius);display:none;" />
      </div>
    </div>

    <!-- Content blocks -->
    <div class="container-site section-y" style="max-width:800px;">
      <div id="project-blocks" class="content-blocks"></div>

      <!-- External link -->
      <div id="project-external" style="margin-top:48px;display:none;">
        <a id="project-external-link" href="#" target="_blank" rel="noopener" class="btn btn-primary">
          Visit Project ↗
        </a>
      </div>
    </div>

    <!-- Next project -->
    <div style="border-top:1px solid var(--border);padding:48px 0;background:var(--surface);" id="project-next-wrap" style="display:none;">
      <div class="container-site">
        <div style="font-size:0.875rem;color:var(--muted);margin-bottom:16px;">Next Project</div>
        <a id="project-next-link" href="#" style="display:flex;align-items:center;gap:16px;text-decoration:none;color:var(--fg);">
          <span id="project-next-title" style="font-family:var(--font-display);font-size:1.5rem;font-weight:600;"></span>
          <span style="color:var(--accent);">→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 404 state -->
  <div id="project-404" style="display:none;text-align:center;" class="section-y container-site">
    <h1 style="font-size:4rem;font-weight:700;color:var(--muted);">404</h1>
    <p style="color:var(--muted);margin:16px 0;">Project not found.</p>
    <a href="/work" class="btn btn-primary">Back to Work</a>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabaseClient';

  const slug = window.location.pathname.split('/').filter(Boolean).pop() || '';

  function renderBlock(block: Record<string, unknown>): string {
    switch (block.type) {
      case 'title':
        return `<h2 style="font-family:var(--font-display);font-size:2rem;font-weight:700;letter-spacing:-0.02em;" class="reveal">${block.content}</h2>`;
      case 'subtitle':
        return `<h3 style="font-family:var(--font-display);font-size:1.375rem;font-weight:600;" class="reveal">${block.content}</h3>`;
      case 'paragraph':
        return `<p style="font-size:1.0625rem;line-height:1.8;color:var(--fg);" class="reveal">${(block.content as string || '').replace(/\n/g, '<br>')}</p>`;
      case 'quote':
        return `<blockquote class="block-quote reveal">${block.content}</blockquote>`;
      case 'divider':
        return `<hr class="block-divider" />`;
      case 'image_large':
        return `<div class="reveal">
          <img src="${block.src || `https://picsum.photos/seed/block-lg/1200/675`}" alt="${block.alt || ''}" loading="lazy" width="1200" height="675"
            style="width:100%;border-radius:var(--radius);" data-lightbox="${block.src || ''}" data-lightbox-group="project-imgs" />
          ${block.caption ? `<p style="text-align:center;font-size:0.8125rem;color:var(--muted);margin-top:8px;">${block.caption}</p>` : ''}
        </div>`;
      case 'image_fullwidth':
        return `<div class="reveal" style="margin-left:calc(var(--section-pad) * -0.5);margin-right:calc(var(--section-pad) * -0.5);">
          <img src="${block.src || `https://picsum.photos/seed/block-fw/1600/900`}" alt="${block.alt || ''}" loading="lazy" width="1600" height="900"
            style="width:100%;" data-lightbox="${block.src || ''}" data-lightbox-group="project-imgs" />
          ${block.caption ? `<p style="text-align:center;font-size:0.8125rem;color:var(--muted);margin-top:8px;">${block.caption}</p>` : ''}
        </div>`;
      case 'image_grid': {
        const imgs = (block.images as string[]) || [];
        return `<div style="display:grid;grid-template-columns:repeat(${Math.min(imgs.length, 3)},1fr);gap:var(--card-gap);" class="reveal">
          ${imgs.map((src, i) => `<img src="${src || `https://picsum.photos/seed/block-grid-${i}/600/450`}" alt="" loading="lazy" width="600" height="450"
            style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius);" data-lightbox="${src}" data-lightbox-group="project-imgs" />`).join('')}
        </div>`;
      }
      case 'text_image':
        return `<div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;" class="reveal">
          <div><p style="font-size:1.0625rem;line-height:1.8;">${block.content || ''}</p></div>
          <img src="${block.src || `https://picsum.photos/seed/block-ti/600/500`}" alt="${block.alt || ''}" loading="lazy" width="600" height="500"
            style="width:100%;border-radius:var(--radius);" data-lightbox="${block.src || ''}" data-lightbox-group="project-imgs" />
        </div>`;
      case 'video':
        return `<div style="aspect-ratio:16/9;border-radius:var(--radius);overflow:hidden;" class="reveal">
          <iframe src="${block.embedUrl || ''}" allow="autoplay;fullscreen;picture-in-picture" allowfullscreen
            style="width:100%;height:100%;border:none;" title="Video"></iframe>
        </div>`;
      case 'before_after':
        return `<div class="before-after-container reveal" style="aspect-ratio:16/9;" id="ba-${Math.random().toString(36).slice(2)}">
          <img src="${block.afterSrc || `https://picsum.photos/seed/after/800/450`}" alt="After" style="width:100%;height:100%;object-fit:cover;" />
          <div style="position:absolute;inset:0;overflow:hidden;width:50%;" class="before-half">
            <img src="${block.beforeSrc || `https://picsum.photos/seed/before/800/450`}" alt="Before" style="width:200%;height:100%;object-fit:cover;" />
          </div>
          <div class="before-after-slider" style="left:50%;">
            <div class="before-after-handle"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L3 8l5 5M16 3l5 5-5 5"/></svg></div>
          </div>
        </div>`;
      case 'metrics': {
        const items = (block.items as Array<{value: string; label: string}>) || [];
        return `<div class="block-metrics reveal">
          ${items.map((item) => `<div class="block-metric-item">
            <div class="block-metric-value">${item.value}</div>
            <div class="block-metric-label">${item.label}</div>
          </div>`).join('')}
        </div>`;
      }
      case 'role_badge':
        return `<div class="reveal"><span class="badge badge-accent" style="font-size:0.875rem;padding:6px 16px;">${block.content}</span></div>`;
      case 'timeline':
        return `<div class="reveal" style="border-left:2px solid var(--accent);padding-left:24px;">
          <p style="font-size:1.0625rem;line-height:1.8;">${(block.content as string || '').replace(/\n/g, '<br>')}</p>
        </div>`;
      case 'color_palette': {
        const colors = (block.colors as Array<{hex: string; name: string}>) || [];
        return `<div class="block-color-palette reveal" style="margin-bottom:32px;">
          ${colors.map((c) => `<div>
            <div class="block-color-swatch" style="background:${c.hex};" data-label="${c.name}"></div>
          </div>`).join('')}
        </div>`;
      }
      case 'typography':
        return `<div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;padding:24px;background:var(--surface);border-radius:var(--radius);">
          ${((block.items as Array<{value: string; label: string}>) || []).map((item) => `
            <div>
              <div style="font-family:${item.value};font-size:2.5rem;font-weight:700;">${item.label}</div>
              <div style="font-size:0.75rem;color:var(--muted);margin-top:4px;">${item.value}</div>
            </div>`).join('')}
        </div>`;
      default:
        return `<div style="padding:16px;background:var(--surface-2);border-radius:var(--radius);font-size:0.875rem;color:var(--muted);">[Block: ${block.type}]</div>`;
    }
  }

  async function loadProject() {
    try {
      const { data: project, error } = await supabase
        .from('projects')
        .select('*')
        .eq('slug', slug)
        .maybeSingle();

      document.getElementById('project-loading')!.style.display = 'none';

      if (error || !project) {
        document.getElementById('project-404')!.style.display = 'block';
        return;
      }

      // Update page title & meta
      document.title = `${project.seo_title || project.title} — Ahmed Sattar`;

      // Show content
      const content = document.getElementById('project-content')!;
      content.style.display = 'block';

      // Breadcrumb
      const breadcrumb = document.getElementById('project-breadcrumb')!;
      breadcrumb.innerHTML = `<a href="/${project.kind}" style="font-size:0.875rem;color:var(--muted);text-decoration:none;">&larr; ${project.kind === 'work' ? 'Work' : 'Personal'}</a>`;

      // Badges
      const badges = document.getElementById('project-badges')!;
      if (project.role_badge) badges.innerHTML += `<span class="badge badge-accent">${project.role_badge}</span>`;
      if (project.category) badges.innerHTML += `<span class="badge badge-muted">${project.category}</span>`;
      if (project.year) badges.innerHTML += `<span class="badge badge-muted">${project.year}</span>`;

      // Title & desc
      document.getElementById('project-title')!.textContent = project.title;
      if (project.short_desc) document.getElementById('project-short-desc')!.textContent = project.short_desc;

      // Meta
      const meta = document.getElementById('project-meta')!;
      const metaItems = [
        project.role_badge ? { label: 'Role', value: project.role_badge } : null,
        project.timeline ? { label: 'Timeline', value: project.timeline } : null,
        project.category ? { label: 'Category', value: project.category } : null,
        project.year ? { label: 'Year', value: String(project.year) } : null,
      ].filter(Boolean);
      meta.innerHTML = metaItems.map(item =>
        `<div><div style="font-size:0.75rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">${item!.label}</div>
         <div style="font-size:0.9375rem;font-weight:500;">${item!.value}</div></div>`
      ).join('');

      // Cover
      const coverImg = document.getElementById('project-cover') as HTMLImageElement;
      if (project.cover_url) {
        coverImg.src = project.cover_url;
        coverImg.alt = project.title;
        coverImg.style.display = 'block';
      } else {
        // Placeholder cover
        coverImg.src = `https://picsum.photos/seed/${project.slug}/1200/675`;
        coverImg.alt = project.title;
        coverImg.style.display = 'block';
      }

      // Content blocks
      const blocksEl = document.getElementById('project-blocks')!;
      const blocks = (project.content_blocks || []) as Record<string, unknown>[];
      if (blocks.length) {
        blocksEl.innerHTML = blocks.map(renderBlock).join('');
      }

      // External link
      if (project.external_link) {
        const extWrap = document.getElementById('project-external')!;
        extWrap.style.display = 'block';
        (document.getElementById('project-external-link') as HTMLAnchorElement).href = project.external_link;
      }

      // Load next project
      const { data: allProjects } = await supabase
        .from('projects')
        .select('title,slug,kind')
        .eq('status', 'published')
        .eq('kind', project.kind)
        .order('sort_order', { ascending: true });

      if (allProjects?.length > 1) {
        const idx = allProjects.findIndex((p: {slug: string}) => p.slug === slug);
        const next = allProjects[(idx + 1) % allProjects.length];
        if (next) {
          document.getElementById('project-next-wrap')!.style.display = 'block';
          const nextLink = document.getElementById('project-next-link') as HTMLAnchorElement;
          nextLink.href = `/${project.kind}/${next.slug}`;
          document.getElementById('project-next-title')!.textContent = next.title;
        }
      }

      // Trigger reveals
      setTimeout(() => {
        document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
      }, 100);

    } catch (err) {
      document.getElementById('project-loading')!.style.display = 'none';
      document.getElementById('project-404')!.style.display = 'block';
    }
  }

  loadProject();
</script>
