---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Dashboard" activeNav="dashboard">
  <div>
    <h1 style="font-family:var(--font-display);font-size:1.75rem;font-weight:700;margin-bottom:8px;">Dashboard</h1>
    <p style="color:var(--muted);font-size:0.9375rem;margin-bottom:40px;">Welcome back to your portfolio CMS.</p>

    <!-- Stats grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:var(--card-gap);margin-bottom:40px;" id="stats-grid">
      <div class="admin-card skeleton" style="height:100px;"></div>
      <div class="admin-card skeleton" style="height:100px;"></div>
      <div class="admin-card skeleton" style="height:100px;"></div>
      <div class="admin-card skeleton" style="height:100px;"></div>
    </div>

    <!-- Recent projects -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--card-gap);">
      <div class="admin-card">
        <h2 style="font-size:1rem;font-weight:600;margin-bottom:16px;">Recent Work Projects</h2>
        <div id="recent-work"></div>
        <a href="/admin/work" style="display:inline-block;margin-top:16px;font-size:0.875rem;color:var(--accent);text-decoration:none;">Manage work →</a>
      </div>
      <div class="admin-card">
        <h2 style="font-size:1rem;font-weight:600;margin-bottom:16px;">Recent Messages</h2>
        <div id="recent-messages"></div>
        <a href="/admin/messages" style="display:inline-block;margin-top:16px;font-size:0.875rem;color:var(--accent);text-decoration:none;">View all →</a>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../lib/supabaseClient';
  import { AuthService } from '../../lib/services/auth';

  // Auth guard
  async function checkAuth() {
    const { user } = await AuthService.getUser();
    if (!user) window.location.href = '/admin/login';
  }
  checkAuth();

  async function loadDashboard() {
    const [workRes, personalRes, messagesRes, unreadRes] = await Promise.all([
      supabase.from('projects').select('count', { count: 'exact' }).eq('kind', 'work'),
      supabase.from('projects').select('count', { count: 'exact' }).eq('kind', 'personal'),
      supabase.from('contact_messages').select('count', { count: 'exact' }),
      supabase.from('contact_messages').select('count', { count: 'exact' }).eq('read', false),
    ]);

    const stats = [
      { label: 'Work Projects', value: workRes.count ?? 0, href: '/admin/work', color: 'var(--accent)' },
      { label: 'Personal Projects', value: personalRes.count ?? 0, href: '/admin/personal', color: 'var(--accent)' },
      { label: 'Total Messages', value: messagesRes.count ?? 0, href: '/admin/messages', color: 'var(--accent)' },
      { label: 'Unread Messages', value: unreadRes.count ?? 0, href: '/admin/messages', color: unreadRes.count ? '#ef4444' : 'var(--accent)' },
    ];

    document.getElementById('stats-grid')!.innerHTML = stats.map(s => `
      <a href="${s.href}" class="admin-card" style="display:block;text-decoration:none;color:inherit;transition:border-color 0.15s ease;"
         onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
        <div style="font-size:2rem;font-weight:700;font-family:var(--font-display);color:${s.color};">${s.value}</div>
        <div style="font-size:0.875rem;color:var(--muted);margin-top:4px;">${s.label}</div>
      </a>`).join('');

    // Recent work projects
    const { data: recentWork } = await supabase.from('projects').select('title,slug,status,kind').eq('kind', 'work').order('created_at', { ascending: false }).limit(5);
    document.getElementById('recent-work')!.innerHTML = (recentWork || []).map((p: {title: string; slug: string; status: string; kind: string}) => `
      <a href="/admin/project/${p.slug}" style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);text-decoration:none;color:var(--fg);"
         onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--fg)'">
        <span style="font-size:0.875rem;font-weight:500;">${p.title}</span>
        <span class="badge ${p.status === 'published' ? 'badge-accent' : 'badge-muted'}">${p.status}</span>
      </a>`).join('') || '<p style="color:var(--muted);font-size:0.875rem;">No projects yet.</p>';

    // Recent messages
    const { data: recentMsgs } = await supabase.from('contact_messages').select('*').order('created_at', { ascending: false }).limit(5);
    document.getElementById('recent-messages')!.innerHTML = (recentMsgs || []).map((m: {id: string; name: string; subject?: string; read: boolean; created_at: string}) => `
      <div style="padding:10px 0;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <span style="font-size:0.875rem;font-weight:${m.read ? '400' : '600'};">${m.name}</span>
          ${!m.read ? '<span class="badge badge-accent">New</span>' : ''}
        </div>
        <div style="font-size:0.8125rem;color:var(--muted);margin-top:2px;">${m.subject || 'No subject'}</div>
      </div>`).join('') || '<p style="color:var(--muted);font-size:0.875rem;">No messages yet.</p>';
  }

  loadDashboard().catch(console.error);
</script>
