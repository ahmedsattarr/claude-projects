---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact — Ahmed Sattar"
  description="Get in touch with Ahmed Sattar for design and digital marketing projects."
>
  <div class="section-y container-site" style="max-width:800px;">
    <div style="margin-bottom:64px;">
      <h1 class="text-display reveal" id="contact-title" style="margin-bottom:16px;">Let's Talk</h1>
      <p class="reveal" style="font-size:1.125rem;color:var(--muted);max-width:520px;line-height:1.7;transition-delay:0.1s;" id="contact-subtitle">
        Have a project in mind or want to collaborate? I'd love to hear from you.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">
      <!-- Contact form -->
      <div class="reveal" style="transition-delay:0.1s;">
        <form id="contact-form" novalidate>
          <div style="margin-bottom:20px;">
            <label class="label" for="contact-name">Name</label>
            <input class="input" type="text" id="contact-name" name="name" placeholder="Your name" required />
          </div>
          <div style="margin-bottom:20px;">
            <label class="label" for="contact-email">Email</label>
            <input class="input" type="email" id="contact-email" name="email" placeholder="your@email.com" required />
          </div>
          <div style="margin-bottom:20px;">
            <label class="label" for="contact-subject">Subject</label>
            <input class="input" type="text" id="contact-subject" name="subject" placeholder="Project inquiry" />
          </div>
          <div style="margin-bottom:28px;">
            <label class="label" for="contact-message">Message</label>
            <textarea class="input" id="contact-message" name="message" rows="5" placeholder="Tell me about your project…" required></textarea>
          </div>

          <div id="form-error" style="display:none;padding:12px 16px;background:rgba(239,68,68,0.1);color:#dc2626;border-radius:var(--radius);font-size:0.875rem;margin-bottom:16px;"></div>
          <div id="form-success" style="display:none;padding:12px 16px;background:rgba(34,197,94,0.1);color:#16a34a;border-radius:var(--radius);font-size:0.875rem;margin-bottom:16px;"></div>

          <button type="submit" class="btn btn-primary" id="submit-btn" style="width:100%;justify-content:center;">
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact info -->
      <div class="reveal" style="transition-delay:0.2s;">
        <div style="margin-bottom:40px;">
          <h3 style="font-size:0.75rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;">Based in</h3>
          <p style="font-size:1rem;">Baghdad, Iraq</p>
        </div>

        <div style="margin-bottom:40px;">
          <h3 style="font-size:0.75rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;" id="contact-availability-label">Availability</h3>
          <div style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px;background:rgba(34,197,94,0.1);border-radius:9999px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#22c55e;flex-shrink:0;"></span>
            <span style="font-size:0.875rem;color:#16a34a;font-weight:500;" id="contact-availability-text">Available for new projects</span>
          </div>
        </div>

        <div>
          <h3 style="font-size:0.75rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:16px;">Social</h3>
          <div style="display:flex;flex-direction:column;gap:12px;" id="contact-social-links">
            <!-- Populated by Boot -->
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabaseClient';
  import { MessagesService } from '../lib/services/messages';

  // Load contact content
  async function loadContactContent() {
    try {
      const { data } = await supabase.from('site_content').select('value').eq('key', 'contact').maybeSingle();
      const content = data?.value as Record<string, string> | null;

      if (content?.title) document.getElementById('contact-title')!.textContent = content.title;
      if (content?.subtitle) document.getElementById('contact-subtitle')!.textContent = content.subtitle;
      if (content?.availability) document.getElementById('contact-availability-text')!.textContent = content.availability;

      // Settings for social links
      const { data: settings } = await supabase.from('settings').select('instagram_url,linkedin_url').maybeSingle();
      const socialLinks = document.getElementById('contact-social-links')!;
      if (settings?.instagram_url) {
        socialLinks.innerHTML += `<a href="${settings.instagram_url}" target="_blank" rel="noopener"
          style="display:inline-flex;align-items:center;gap:8px;color:var(--fg);text-decoration:none;font-size:0.9375rem;transition:color 0.15s ease;"
          onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--fg)'">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          Instagram
        </a>`;
      }
      if (settings?.linkedin_url) {
        socialLinks.innerHTML += `<a href="${settings.linkedin_url}" target="_blank" rel="noopener"
          style="display:inline-flex;align-items:center;gap:8px;color:var(--fg);text-decoration:none;font-size:0.9375rem;transition:color 0.15s ease;"
          onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--fg)'">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </a>`;
      }
    } catch {}
  }

  // Form submit
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('form-error')!;
  const successEl = document.getElementById('form-success')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';
    successEl.style.display = 'none';

    const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
    const subject = (document.getElementById('contact-subject') as HTMLInputElement).value.trim();
    const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) {
      errorEl.textContent = 'Please fill in all required fields.';
      errorEl.style.display = 'block';
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errorEl.textContent = 'Please enter a valid email address.';
      errorEl.style.display = 'block';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const { error } = await MessagesService.send({ name, email, subject, message });

    if (error) {
      errorEl.textContent = 'Failed to send message. Please try again.';
      errorEl.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    } else {
      successEl.textContent = 'Message sent! I\'ll get back to you soon.';
      successEl.style.display = 'block';
      form.reset();
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    }
  });

  loadContactContent();
  setTimeout(() => document.querySelectorAll('.reveal:not(.visible)').forEach(el => el.classList.add('visible')), 100);
</script>
