---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Personal — Ahmed Sattar"
  description="Personal projects and experiments by Ahmed Sattar."
>
  <div class="section-y container-site">
    <div style="margin-bottom:64px;">
      <h1 class="text-display reveal" style="margin-bottom:16px;">Personal</h1>
      <p class="reveal" style="font-size:1.125rem;color:var(--muted);max-width:560px;line-height:1.7;transition-delay:0.1s;">
        Personal experiments, passion projects, and creative explorations.
      </p>
    </div>

    <!-- Layout switcher -->
    <div style="display:flex;gap:8px;margin-bottom:40px;">
      <button class="btn btn-secondary" data-layout="grid" id="btn-grid" style="padding:8px 16px;background:var(--accent);color:#fff;border-color:var(--accent);">Grid</button>
      <button class="btn btn-secondary" data-layout="list" id="btn-list" style="padding:8px 16px;">List</button>
      <button class="btn btn-secondary" data-layout="bento" id="btn-bento" style="padding:8px 16px;">Bento</button>
    </div>

    <div id="personal-skeleton">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--card-gap);">
        <div class="skeleton" style="height:260px;"></div>
        <div class="skeleton" style="height:260px;"></div>
        <div class="skeleton" style="height:260px;"></div>
      </div>
    </div>

    <div id="personal-container" style="display:none;"></div>
  </div>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabaseClient';

  type Project = { id: string; title: string; slug: string; cover_url?: string; category?: string; year?: number; short_desc?: string; kind: 'work'|'personal'; tags?: string[]; };

  let layout = 'grid';
  let projects: Project[] = [];

  function renderGrid(items: Project[]) {
    return `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--card-gap);">
      ${items.map((p, i) => `
        <a href="/personal/${p.slug}" class="project-card reveal" style="display:block;background:var(--surface);border:1px solid var(--border);text-decoration:none;color:var(--fg);transition-delay:${i * 0.05}s;">
          <div style="aspect-ratio:4/3;overflow:hidden;">
            <img src="${p.cover_url || `https://picsum.photos/seed/p-${p.slug}/560/420`}" alt="${p.title}" loading="lazy" width="560" height="420"
              style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease;"
              onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'" />
          </div>
          <div style="padding:20px;">
            ${(p.tags||[]).slice(0,2).map((t:string)=>`<span class="badge badge-muted" style="margin-right:6px;">${t}</span>`).join('')}
            ${p.year ? `<span class="badge badge-muted">${p.year}</span>` : ''}
            <h3 style="font-family:var(--font-display);font-size:1.0625rem;font-weight:600;margin-top:10px;margin-bottom:6px;">${p.title}</h3>
            ${p.short_desc ? `<p style="font-size:0.875rem;color:var(--muted);line-height:1.6;">${p.short_desc}</p>` : ''}
          </div>
        </a>`).join('')}
    </div>`;
  }

  function renderList(items: Project[]) {
    return `<div>${items.map((p, i) => `
      <a href="/personal/${p.slug}" class="project-list-row reveal" style="text-decoration:none;color:var(--fg);transition-delay:${i*0.04}s;"
         data-preview-img="${p.cover_url || `https://picsum.photos/seed/p-${p.slug}/440/330`}">
        <span class="project-list-num">${String(i+1).padStart(2,'0')}</span>
        <div>
          <div style="font-family:var(--font-display);font-size:1.0625rem;font-weight:600;">${p.title}</div>
          <div style="font-size:0.875rem;color:var(--muted);margin-top:2px;">${p.category||''}</div>
        </div>
        <span style="font-size:0.875rem;color:var(--muted);">${p.year||''}</span>
      </a>`).join('')}</div>`;
  }

  function renderBento(items: Project[]) {
    const sizes = ['bento-large','bento-small','bento-small','bento-large','bento-small','bento-small'];
    return `<div class="bento-grid">${items.map((p, i) => {
      const cls = sizes[i % sizes.length];
      return `<a href="/personal/${p.slug}" class="${cls} project-card reveal" style="display:block;background:var(--surface);border:1px solid var(--border);text-decoration:none;color:var(--fg);transition-delay:${i*0.05}s;">
        <div style="aspect-ratio:${cls==='bento-large'?'16/9':'4/3'};overflow:hidden;">
          <img src="${p.cover_url || `https://picsum.photos/seed/p-${p.slug}/800/600`}" alt="${p.title}" loading="lazy" width="800" height="600"
            style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease;"
            onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'" />
        </div>
        <div style="padding:16px;">
          <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:600;">${p.title}</h3>
          <p style="font-size:0.8125rem;color:var(--muted);">${p.category||''}</p>
        </div>
      </a>`;
    }).join('')}</div>`;
  }

  function render() {
    const c = document.getElementById('personal-container')!;
    c.style.display = 'block';
    if (layout === 'grid') c.innerHTML = renderGrid(projects);
    else if (layout === 'list') c.innerHTML = renderList(projects);
    else c.innerHTML = renderBento(projects);
    document.querySelectorAll('.reveal:not(.visible)').forEach(el => el.classList.add('visible'));
  }

  document.querySelectorAll('[data-layout]').forEach(btn => {
    btn.addEventListener('click', () => {
      layout = (btn as HTMLElement).dataset.layout!;
      document.querySelectorAll('[data-layout]').forEach(b => {
        (b as HTMLElement).style.cssText += ';background:transparent;color:var(--fg);border-color:var(--border);';
      });
      Object.assign((btn as HTMLElement).style, {background:'var(--accent)',color:'#fff',borderColor:'var(--accent)'});
      render();
    });
  });

  async function load() {
    try {
      const layoutRes = await supabase.from('site_content').select('value').eq('key','layout_personal').maybeSingle();
      if (layoutRes.data?.value?.type) {
        layout = layoutRes.data.value.type;
        const activeBtn = document.querySelector(`[data-layout="${layout}"]`) as HTMLElement;
        if (activeBtn) Object.assign(activeBtn.style, {background:'var(--accent)',color:'#fff',borderColor:'var(--accent)'});
        document.querySelectorAll(`[data-layout]:not([data-layout="${layout}"])`).forEach(b => {
          Object.assign((b as HTMLElement).style, {background:'transparent',color:'var(--fg)',borderColor:'var(--border)'});
        });
      }

      const { data } = await supabase.from('projects').select('*').eq('status','published').eq('kind','personal').order('sort_order',{ascending:true});
      projects = data || [];
      document.getElementById('personal-skeleton')!.style.display = 'none';
      if (!projects.length) {
        document.getElementById('personal-container')!.style.display = 'block';
        document.getElementById('personal-container')!.innerHTML = `<p style="color:var(--muted);text-align:center;padding:80px 0;">No personal projects yet.</p>`;
      } else {
        render();
      }
    } catch {
      document.getElementById('personal-skeleton')!.style.display = 'none';
      document.getElementById('personal-container')!.style.display = 'block';
      document.getElementById('personal-container')!.innerHTML = `<p style="color:var(--muted);text-align:center;padding:80px 0;">Could not load projects.</p>`;
    }
  }
  load();
</script>
